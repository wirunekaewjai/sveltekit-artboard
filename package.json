{
  "name": "sveltekit-artboard",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "author": "Wirune Kaewjai",
  "files": [
    "dist",
    "README.md",
    "AGENT_GUIDE.md",
    "LICENSE"
  ],
  "type": "module",
  "imports": {
    "#src/*": "./src/*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./registry": {
      "types": "./dist/registry.d.mts",
      "default": "./dist/registry.mjs"
    },
    "./studio": {
      "types": "./dist/studio.d.ts",
      "default": "./dist/studio.js"
    }
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && vp pack",
    "check": "vp check",
    "dev:example": "pnpm --dir examples/sveltekit dev",
    "build:example": "pnpm --dir examples/sveltekit build",
    "format": "vp fmt .",
    "lint": "vp fmt --check . && vp lint .",
    "prepare": "node scripts/prepare.mjs",
    "pretest:e2e": "pnpm run build",
    "test": "vp test",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "hono": "^4.13.22",
    "uuid": "^14.0.3",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@lucide/svelte": "^1.77.0",
    "@playwright/test": "^1.59.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^22.15.0",
    "eslint-plugin-svelte": "^3.24.1",
    "svelte": "^5.59.1",
    "typescript": "^6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8000",
    "vite-plus": "1.7.0"
  },
  "peerDependencies": {
    "svelte": "^5.0.0",
    "vite": "^8.0.0"
  },
  "pnpm": {
    "overrides": {
      "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8000"
    }
  }
}
