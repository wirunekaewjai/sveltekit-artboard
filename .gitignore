# single-level ignore
.artboard/
.vitest/
blob-report/
coverage/
node_modules/
playwright-report/
test-results/

# multi-level ignore
**/.DS_Store
**/.env
**/.env.*
**/.svelte-kit
**/Thumbs.db
**/node_modules
**/vite.config.js.timestamp-*
**/vite.config.ts.timestamp-*
examples/**/build
examples/**/dist
examples/**/.artboard

# single-level track
!.vscode/
!.vscode/extensions.json
!.vscode/settings.json

# multi-level track
!**/.env.example
!**/.env.test
